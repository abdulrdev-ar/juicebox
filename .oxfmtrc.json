{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "sortImports": true,
  "sortTailwindcss": { "stylesheet": "./src/app/globals.css" },
  "ignorePatterns": [
    "*.md",
    "pnpm-lock.yaml",
    "public/assets/*.json",
    "graphify-out"
  ]
}
